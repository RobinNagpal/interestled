node_modules/
.turbo/
dist/
.expo/
*.tsbuildinfo

# Generated by `expo prebuild` on every Android build and never edited
# by hand, so the repository holds app.json and the workflow rather than
# a native project that can silently drift from it.
apps/mobile/android/
apps/mobile/ios/

# Secrets and local config
.env
# Every variant, not just .local: a .env.bak or .env.prod written in a hurry is
# the one that carries a real credential and is not covered by a named rule.
.env.*
apps/*/.env

# Terraform
deployment/dist/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Saved plan files: they embed every value the plan touched, including the
# generated SSH private key, so they must never be committed.
tfplan
*.tfplan

.DS_Store
.envrc
*.iml
.idea/
