# Postgres. Neon and Supabase free tiers both work.
#
# Deploying to Lambda? Append ?connection_limit=1&pool_timeout=20 and use the
# provider's POOLED endpoint. Every warm container holds its own Prisma pool, so
# the default sizing fans out to hundreds of connections under modest traffic
# and the database starts refusing them. This is the most common way a
# Prisma-on-Lambda deployment falls over.
DATABASE_URL="postgresql://user:password@localhost:5432/interestled"

# Which LLM generates content. Only "gemini" is implemented today; the registry
# in src/llm/registry.ts is where another provider gets added.
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.6-flash"
GEMINI_API_KEY="..."

# Optional
PORT=7071

# Comma-separated browser origins allowed to call this API. Only needed for
# local development: in production CloudFront serves the app and the API from
# one domain, so no origin is cross-origin. Defaults to the Expo dev ports.
ALLOWED_ORIGINS="http://localhost:7070"
